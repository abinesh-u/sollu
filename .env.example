GOOGLE_CLOUD_PROJECT="sixth-radar-506906-i1"
GOOGLE_CLOUD_LOCATION="global"
GOOGLE_GENAI_USE_VERTEXAI="TRUE"
CRON_SECRET="super_secret_cron_token_123"

# Optional. Gates POST /tasks, approve, reject, and delete behind a shared
# secret (header X-Api-Secret). Unset by default so local/demo setup needs no
# extra step. If you set it, also set VITE_API_SECRET to the same value in
# frontend/.env so the UI sends it — see README's Security & Governance.
API_SECRET=""

# Google Workspace Credentials (Optional - for Tier 2 setup)
# If missing, Workspace tools will degrade gracefully to draft/simulation mode.
GOOGLE_CLIENT_ID="your_client_id_here"
GOOGLE_CLIENT_SECRET="your_client_secret_here"
SETUP_ENABLED="true"
SETUP_PASSWORD="your_setup_password_here"
OAUTH_REDIRECT_URI="http://localhost:8080/oauth/callback"
INTERNAL_MCP_URL="http://localhost:8080/sse"

# Notion Integration (Optional)
NOTION_API_KEY="your_notion_integration_token"
NOTION_DATABASE_ID="your_notion_database_id"
